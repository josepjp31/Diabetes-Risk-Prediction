{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: current file (--fast)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": ["--fast"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
